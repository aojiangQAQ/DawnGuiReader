{
  "schemaVersion": 1,
  "id": "dawn_accessibility",
  "version": "${version}",
  "name": "Dawn GUI Reader",
  "description": "A client-side accessibility reader for inventory and container item names.",
  "authors": [
    "曙光（Dawn）团队 - 鳌江"
  ],
  "contact": {
    "homepage": "https://fabricmc.net/",
    "sources": "https://github.com/DawnTeam/DawnGuiReader"
  },
  "license": "MIT",
  "environment": "client",
  "entrypoints": {
    "client": [
      "org.dawnteam.accessibility.DawnAccessibilityClient"
    ]
  },
  "mixins": [
    {
      "config": "dawn_accessibility.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.2",
    "minecraft": ">=26.1 <26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
